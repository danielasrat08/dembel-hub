# Copy to .env and fill in. Never commit .env.

# Public address of the app (Caddy gets HTTPS automatically for a real domain).
# For a first test without a domain, use the server IP with :80 → APP_DOMAIN=:80
APP_DOMAIN=hub.example.com

# PostgreSQL
POSTGRES_DB=dembel_hub
POSTGRES_USER=dembel
POSTGRES_PASSWORD=change-me-long-random
DATABASE_URL=postgresql://dembel:change-me-long-random@db:5432/dembel_hub?schema=public

# Redis (scheduled jobs, reminders)
REDIS_URL=redis://redis:6379

# Optional visit proof and contract scans are stored on a Docker volume on the test server.
# Production can switch to S3-compatible storage by setting these:
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# API
WEB_ORIGIN=https://hub.example.com
JWT_SECRET=change-me-64-random-chars

# Real staff roster (kept off git). Copy staff.private.json to the server and point here:
STAFF_SEED_FILE=/data/files/staff.private.json
SEED_SALES_MANAGER_NAME=

# First Office Admin login (used once by the seed; change the password on first login)
SEED_ADMIN_PASSWORD=change-me-temporary

# Phase 2: Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# Phase 1: Google service account JSON (base64) for Google Sheets exports
GOOGLE_SERVICE_ACCOUNT_B64=
